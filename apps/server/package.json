{
  "name": "@praisesuite/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --banner:js=\"import{createRequire as __psCreateRequire}from'node:module';const require=__psCreateRequire(import.meta.url);\" --outfile=dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@praisesuite/api-contracts": "workspace:*",
    "@praisesuite/core": "workspace:*",
    "@praisesuite/storage-sqlite": "workspace:*",
    "fflate": "^0.8.3",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.10",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
